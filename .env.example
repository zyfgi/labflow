# ===== LabFlow environment template =====
# Copy to .env and change every secret before deploying.
#   cp .env.example .env

# application
LABFLOW_ENV=development
LABFLOW_DEBUG=true

# SECURITY: generate a real secret for production, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
LABFLOW_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# database (inside docker compose the host is "postgres")
POSTGRES_USER=labflow
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=labflow
DATABASE_URL=postgresql+psycopg2://labflow:change-me-db-password@postgres:5432/labflow

# CORS: comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1

# file storage
UPLOAD_DIR=./storage
UPLOAD_MAX_MB=100

# seed safety: demo seed is refused when ENV=production unless explicitly enabled
# ALLOW_DEMO_SEED=false

# timezone used for "today / this week" business logic and AI retrieval
APP_TIMEZONE=Asia/Shanghai

# ===== AI 助手（只读；OpenAI-compatible；密钥仅保存在后端） =====
AI_ENABLED=false
# 任意 OpenAI-compatible endpoint，例如：
#   https://api.openai.com/v1
#   https://api.deepseek.com/v1
#   https://open.bigmodel.cn/api/paas/v4
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60
AI_MAX_CONTEXT_CHARS=30000
AI_MAX_RETRIEVAL_HITS=16
# 审计日志是否记录用户问题文本（默认 false，最小化存储）
AI_AUDIT_STORE_QUERY=false
# /ai/retrieve 调试接口：unset 时 development 开启、production 关闭
# AI_DEBUG_RETRIEVAL=false
# 每用户限流
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=100
