# ===== LabFlow environment template =====
# Copy to .env and change every secret before deploying.
#   cp .env.example .env

# application
LABFLOW_ENV=development
LABFLOW_DEBUG=true

# SECURITY: generate a real secret for production, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
LABFLOW_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# database (inside docker compose the host is "postgres")
POSTGRES_USER=labflow
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=labflow
DATABASE_URL=postgresql+psycopg2://labflow:change-me-db-password@postgres:5432/labflow

# CORS: comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1

# file storage
UPLOAD_DIR=./storage
UPLOAD_MAX_MB=100
