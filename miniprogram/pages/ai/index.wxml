<view class="chat">
  <view
    wx:for="{{messages}}"
    wx:key="index"
    class="bubble {{item.role === 'user' ? 'mine' : ''}}"
  >{{item.content}}</view>
  <view wx:if="{{loading}}" class="muted" style="padding: 12rpx">思考中…</view>
  <view wx:if="{{!messages.length}}" class="empty">
    试试问：本周大家做了哪些实验？谁的任务逾期了？
  </view>
</view>
<view class="composer">
  <input value="{{input}}" bindinput="onInput" placeholder="向 AI 提问（只读检索）" confirm-type="send" bindconfirm="send" />
  <button class="btn" size="mini" bindtap="send">发送</button>
</view>
