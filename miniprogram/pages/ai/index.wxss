.chat {
  padding: 20rpx;
  min-height: 70vh;
}

.bubble {
  background: #fff;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 16rpx;
  max-width: 80%;
}

.bubble.mine {
  background: #409eff;
  color: #fff;
  margin-left: auto;
}

.composer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #ebeef5;
}

.composer input {
  flex: 1;
  background: #f5f7fa;
  border-radius: 10rpx;
  padding: 14rpx 20rpx;
}
