.tabs {
  display: flex;
  background: #fff;
  padding: 0 20rpx;
  border-bottom: 1rpx solid #ebeef5;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  color: #909399;
  border-bottom: 4rpx solid transparent;
}

.tab.active {
  color: #409eff;
  border-bottom-color: #409eff;
  font-weight: 600;
}
